# ZDistributeLLMonIntel — copy to zdl.env (never commit)

# HTTP_PROXY=http://proxy-us.intel.com:911
# HTTPS_PROXY=http://proxy-us.intel.com:911

# Coordinator
# ZDL_COORDINATOR_HOST=127.0.0.1
# ZDL_COORDINATOR_PORT=7443
# ZDL_COORDINATOR_API_TOKEN=dev-coordinator-token
# ZDL_COORDINATOR_ENROLL_TOKEN=dev-enroll-token
# ZDL_COORDINATOR_PUBLIC_URL=https://your-public-host:7443

# OpenAI gateway (Cursor base URL → http://127.0.0.1:8080/v1)
# ZDL_GATEWAY_HOST=127.0.0.1
# ZDL_GATEWAY_PORT=8080
# ZDL_GATEWAY_COORDINATOR_URL=http://127.0.0.1:7443
# ZDL_GATEWAY_COORDINATOR_TOKEN=dev-coordinator-token
# ZDL_GATEWAY_API_KEY=dev-gateway-key

# Worker agent (one process per edge node)
# ZDL_WORKER_COORDINATOR_URL=http://127.0.0.1:7443
# ZDL_WORKER_COORDINATOR_TOKEN=dev-coordinator-token
# ZDL_WORKER_ENROLL_TOKEN=dev-enroll-token

# Edge UI (remote nodes)
# ZDL_EDGE_UI_PORT=7340
# ZDL_WORKER_WORKER_ID=shard-0
# ZDL_WORKER_SITE_ID=lab
# ZDL_WORKER_OPENAI_BASE_URL=http://192.168.1.11:8081
# ZDL_WORKER_RPC_HOST=192.168.1.10
# ZDL_WORKER_RPC_PORT=50052
